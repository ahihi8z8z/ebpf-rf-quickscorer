# QuickScorer eBPF/XDP testbed — shared settings (hypervisor: fil100 / node1)
HV_IP=192.168.101.10
HV_USER=haipt
HV_IFACE=eno1                 # LAN NIC on fil100; mgmt NICs attach via macvtap (bridge mode)

# Management (LAN) — reachable directly from server3 and the rest of 192.168.101.0/24
LAN_GW=192.168.101.1
LAN_PREFIX=24
DNS1=8.8.8.8
DNS2=1.1.1.1

# ---- DUT: runs the XDP classifiers (H-DT, H-NN, G-RF, QS-1, QS-G) ----
DUT_NAME=qs-dut
DUT_IP=192.168.101.51
DUT_MAC_MGMT=52:54:00:51:00:51
DUT_MAC_D0=52:54:00:51:a0:51     # link A (ingress from TG)
DUT_MAC_D1=52:54:00:51:b0:51     # link B (egress back to TG)
DUT_VCPUS=8
DUT_CPUSET=2-9                   # host cores reserved for DUT vCPUs
DUT_RAM_MB=16384
DUT_D0_IP=10.50.0.1
DUT_D1_IP=10.51.0.1

# ---- TG: traffic generator / PCAP replay / sink ----
TG_NAME=qs-tg
TG_IP=192.168.101.52
TG_MAC_MGMT=52:54:00:51:00:52
TG_MAC_D0=52:54:00:51:a0:52      # link A (tx toward DUT)
TG_MAC_D1=52:54:00:51:b0:52      # link B (rx from DUT; lives in netns "rx")
TG_VCPUS=6
TG_CPUSET=10-15
TG_RAM_MB=8192
TG_D0_IP=10.50.0.2
TG_D1_IP=10.51.0.2

DATA_QUEUES=8                    # virtio-net queue pairs per data NIC (>= DUT vCPUs for XDP_TX/REDIRECT)
DISK_GB=60
VM_USER=haipt
VM_PASS=${VM_PASS:?set VM_PASS in the environment}

# Isolated L2 data links (libvirt networks: no host IP, no DHCP, no forwarding)
NET_A=qs-a ; BR_A=virbr-qsa
NET_B=qs-b ; BR_B=virbr-qsb

IMG_DIR=/var/lib/libvirt/images/qs
BASE_IMG=noble-server-cloudimg-amd64.img
